From dd6227c4086ebc8c5064df16498f20ade37426f1 Mon Sep 17 00:00:00 2001
From: marquies <me@patrickbreucking.de>
Date: Thu, 29 Oct 2026 13:10:13 +0100
Subject: [PATCH] feat(mxl-gst-testsrc): write faults into a flow on command

A reader's content checks could only be shown at work with a test
writer of synthetic grains, beside the real source and on flows of its
own. With MXL_TESTSRC_FAULTS naming a directory, each flow takes
commands from the FIFO <directory>/<flow id>: the next N grains
flagged invalid, committed with half their slices, carrying v210 code 0,
or claiming one line fewer than they have; or no writing for S seconds.
An audio flow takes the pause only. Without the variable nothing
listens and every grain is written as before.
---
 tools/mxl-gst/faults.hpp  | 215 ++++++++++++++++++++++++++++++++++++++
 tools/mxl-gst/testsrc.cpp |  96 ++++++++++++++++-
 2 files changed, 308 insertions(+), 3 deletions(-)
 create mode 100644 tools/mxl-gst/faults.hpp

diff --git a/tools/mxl-gst/faults.hpp b/tools/mxl-gst/faults.hpp
new file mode 100644
index 00000000..5d22d6f2
--- /dev/null
+++ b/tools/mxl-gst/faults.hpp
@@ -0,0 +1,215 @@
+// Faults mxl-gst-testsrc writes into a flow on command, so a reader's checks
+// can be shown at work on real media. Off unless MXL_TESTSRC_FAULTS names a
+// directory: each flow then takes commands, one per line, from the FIFO
+// <directory>/<flow id>.
+//
+//   invalid N    the next N grains carry the invalid flag and no payload
+//   partial N    the next N grains are committed with half their slices
+//   illegal N    the next N grains carry v210 code 0 throughout
+//   size N       the next N grains claim one line fewer than they have
+//   pause S      the flow is not written for S seconds
+//
+// An audio flow takes pause only.
+
+#pragma once
+
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <thread>
+#include <utility>
+#include <fcntl.h>
+#include <poll.h>
+#include <unistd.h>
+#include <sys/stat.h>
+
+namespace faults
+{
+    enum class Kind
+    {
+        None,
+        Invalid,
+        Partial,
+        Illegal,
+        Size,
+        Pause
+    };
+
+    struct Command
+    {
+        Kind kind = Kind::None;
+        // Grains for a grain fault.
+        std::uint64_t count = 0;
+        // For a pause.
+        std::chrono::nanoseconds duration{0};
+    };
+
+    // The command in line, or nothing where it is not one a flow of this kind
+    // takes.
+    inline std::optional<Command> parse(std::string_view line, bool discrete)
+    {
+        while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+        {
+            line.remove_suffix(1);
+        }
+        auto const space = line.find(' ');
+        if (space == std::string_view::npos)
+        {
+            return std::nullopt;
+        }
+        auto const name = line.substr(0, space);
+        auto const argument = std::string{line.substr(space + 1)};
+        char* end = nullptr;
+        if (name == "pause")
+        {
+            auto const seconds = std::strtod(argument.c_str(), &end);
+            if (end == argument.c_str() || *end != '\0' || !(seconds > 0.0) || seconds > 3600.0)
+            {
+                return std::nullopt;
+            }
+            return Command{.kind = Kind::Pause, .duration = std::chrono::nanoseconds{static_cast<std::int64_t>(std::llround(seconds * 1e9))}};
+        }
+        auto const kind = name == "invalid" ? Kind::Invalid
+                        : name == "partial" ? Kind::Partial
+                        : name == "illegal" ? Kind::Illegal
+                        : name == "size"    ? Kind::Size
+                                            : Kind::None;
+        if (kind == Kind::None || !discrete)
+        {
+            return std::nullopt;
+        }
+        auto const count = std::strtoull(argument.c_str(), &end, 10);
+        if (end == argument.c_str() || *end != '\0' || argument.front() == '-' || count == 0 || count > 100000)
+        {
+            return std::nullopt;
+        }
+        return Command{.kind = kind, .count = count};
+    }
+
+    // What a flow still has to write wrong. Set by the listener, taken by
+    // the flow's writer, a grain or a pause at a time.
+    class State
+    {
+    public:
+        void apply(Command const& command)
+        {
+            auto const lock = std::lock_guard{_mutex};
+            if (command.kind == Kind::Pause)
+            {
+                _pause = command.duration;
+            }
+            else
+            {
+                _kind = command.kind;
+                _remaining = command.count;
+            }
+        }
+
+        // The fault for the next grain, and one fewer to come.
+        Kind takeGrain()
+        {
+            auto const lock = std::lock_guard{_mutex};
+            if (_remaining == 0)
+            {
+                return Kind::None;
+            }
+            --_remaining;
+            return _kind;
+        }
+
+        // A pause asked for, once.
+        std::chrono::nanoseconds takePause()
+        {
+            auto const lock = std::lock_guard{_mutex};
+            return std::exchange(_pause, std::chrono::nanoseconds{0});
+        }
+
+    private:
+        std::mutex _mutex;
+        Kind _kind = Kind::None;
+        std::uint64_t _remaining = 0;
+        std::chrono::nanoseconds _pause{0};
+    };
+
+    // Reads commands from the FIFO at path into state until stop is set, and
+    // removes the FIFO then. Held open for writing as well, so a writer
+    // closing it is no end of input.
+    class Listener
+    {
+    public:
+        Listener(std::string path, State& state, bool discrete, std::atomic<int> const& stop, std::function<void(std::string const&)> log)
+            : _path{std::move(path)}
+        {
+            ::unlink(_path.c_str());
+            if (::mkfifo(_path.c_str(), 0622) != 0)
+            {
+                throw std::runtime_error{"cannot create the fault FIFO " + _path + ": " + std::strerror(errno)};
+            }
+            _fd = ::open(_path.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC);
+            if (_fd < 0)
+            {
+                auto const error = std::string{std::strerror(errno)};
+                ::unlink(_path.c_str());
+                throw std::runtime_error{"cannot open the fault FIFO " + _path + ": " + error};
+            }
+            _thread = std::thread{[this, &state, discrete, &stop, log = std::move(log)]
+                {
+                    auto pending = std::string{};
+                    while (!stop)
+                    {
+                        auto pfd = pollfd{.fd = _fd, .events = POLLIN, .revents = 0};
+                        if (::poll(&pfd, 1, 200) != 1)
+                        {
+                            continue;
+                        }
+                        char buffer[256];
+                        auto const n = ::read(_fd, buffer, sizeof(buffer));
+                        if (n <= 0)
+                        {
+                            continue;
+                        }
+                        pending.append(buffer, static_cast<std::size_t>(n));
+                        for (auto end = pending.find('\n'); end != std::string::npos; end = pending.find('\n'))
+                        {
+                            auto const line = pending.substr(0, end);
+                            pending.erase(0, end + 1);
+                            if (auto const command = parse(line, discrete))
+                            {
+                                state.apply(*command);
+                                log("fault: " + line);
+                            }
+                            else
+                            {
+                                log("fault refused: '" + line + "'");
+                            }
+                        }
+                    }
+                }};
+        }
+
+        Listener(Listener const&) = delete;
+        Listener& operator=(Listener const&) = delete;
+
+        ~Listener()
+        {
+            _thread.join();
+            ::close(_fd);
+            ::unlink(_path.c_str());
+        }
+
+    private:
+        std::string _path;
+        int _fd = -1;
+        std::thread _thread;
+    };
+}
