@@ -1165,6 +1213,24 @@ namespace
 
     private:
         mxlMonitoringFlow _flow;
+        faults::State* _faults = nullptr;
+        // The grain size of the first grain opened, which every grain has.
+        decltype(mxlGrainInfo::grainSize) _grainSize = 0;
+
+        // Holds the flow's thread for a pause asked for, writing nothing.
+        void pauseOnCommand()
+        {
+            if (_faults == nullptr)
+            {
+                return;
+            }
+            auto const pause = _faults->takePause();
+            auto const until = std::chrono::steady_clock::now() + pause;
+            while (pause.count() > 0 && !g_exit_requested && std::chrono::steady_clock::now() < until)
+            {
+                std::this_thread::sleep_for(std::chrono::milliseconds{10});
+            }
+        }
         mxlInstance _instance;
 
         mxlFlowWriter _writer;
@@ -1184,6 +1250,24 @@ namespace
     }
 }
 
+namespace
+{
+    // The listener for a flow's fault commands where MXL_TESTSRC_FAULTS names
+    // a directory, or none.
+    std::unique_ptr<faults::Listener> listenForFaults(std::string const& flowId, bool discrete, faults::State& state)
+    {
+        auto const* directory = std::getenv("MXL_TESTSRC_FAULTS");
+        if (directory == nullptr || *directory == '\0')
+        {
+            return nullptr;
+        }
+        auto listener = std::make_unique<faults::Listener>(std::string{directory} + "/" + flowId, state, discrete, g_exit_requested,
+            [flowId](std::string const& line) { MXL_INFO("Flow {}: {}", flowId, line); });
+        MXL_WARN("Flow {} writes faults on command from {}/{}", flowId, directory, flowId);
+        return listener;
+    }
+}
